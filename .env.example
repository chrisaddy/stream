# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stream

# Redis
REDIS_URL=redis://localhost:6379/0

# Prefect Cloud
PREFECT_API_URL=https://api.prefect.cloud/api/accounts/YOUR_ACCOUNT/workspaces/YOUR_WORKSPACE
