# Cloudflare R2
R2_ENDPOINT_URL=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=stream-models

# Anthropic
ANTHROPIC_API_KEY=

# App
APP_HOST=0.0.0.0
APP_PORT=5000
DEBUG=false
